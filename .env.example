# Copy to .env and fill locally. Never commit .env or share keys.
RFQ_MODEL_BASE_URL=https://api.deepseek.com
RFQ_MODEL_NAME=deepseek-flash
RFQ_MODEL_API_KEY=
RFQ_MODEL_TIMEOUT=180
RFQ_MODEL_JSON_MODE=true
# false connects directly; true uses Windows/system/environment proxy settings.
RFQ_MODEL_TRUST_ENV=false
